{
  "name": "steering-allocation",
  "version": "1.0.0-beta",
  "private": true,
  "description": "Steering & Allocation: carrier contracts, the routing guide (who books which carrier and contract, with the space on each), the CW1 TN ledger, CW1 / NYSHEX report imports and consumption dashboards. Standalone, on-prem, SQLite.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:server\" \"npm:client\"",
    "server": "node server/index.js",
    "client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "reset-db": "node server/reset.js",
    "test": "node --test --test-concurrency=1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.18.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "puppeteer-core": "^25.12.0",
    "vite": "^5.2.0"
  }
}
